{
  "name": "@devcrish/headwind",
  "version": "0.1.0",
  "description": "React widgets you can drag, resize and measure in the browser, then hardcode and deploy.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.js",
    "test": "vitest run",
    "build:example": "vite build --config vite.config.js",
    "build:lib": "vite build --config vite.lib.config.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "socket.io-client": "^4.8.4"
  }
}
